<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.teamadvert.chesscam.ui.CameraBoardView
            android:id="@+id/camera"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#B3000000"
            android:padding="10dp"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.teamadvert.chesscam.ui.BoardDiagramView
            android:id="@+id/diagram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="45" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="55"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/suggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/accent"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/evaluation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/moveList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="start"
                android:maxLines="3"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/colorButton"
                style="@style/BarButton" />

            <Button
                android:id="@+id/rotateButton"
                style="@style/BarButton"
                android:text="@string/rotate" />

            <Button
                android:id="@+id/startButton"
                style="@style/BarButton.Primary"
                android:text="@string/start" />

            <Button
                android:id="@+id/pauseButton"
                style="@style/BarButton"
                android:text="@string/pause" />

            <Button
                android:id="@+id/undoButton"
                style="@style/BarButton"
                android:text="@string/undo" />

            <Button
                android:id="@+id/repeatButton"
                style="@style/BarButton"
                android:text="@string/repeat" />

            <Button
                android:id="@+id/resyncButton"
                style="@style/BarButton"
                android:text="@string/resync" />

            <Button
                android:id="@+id/moreButton"
                style="@style/BarButton"
                android:text="@string/more" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
